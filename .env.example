# 백엔드 설정값 예시. 이 파일을 .env 로 복사한 뒤 값을 채운다. (.env 는 GitHub에 올라가지 않음)

# PostgreSQL 주소. 끝에 ?schema=level3 를 붙여 이 과제용 공간만 쓴다.
#  - 로컬: Render DB의 External 주소 + ?schema=level3&sslmode=verify-full
#  - Render 백엔드: Render DB의 Internal 주소 + ?schema=level3
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?schema=level3"

# 로그인 출입증(JWT) 서명용 비밀 문자열. 길고 무작위로.
JWT_SECRET="아무도-모르는-긴-무작위-문자열"

# GPT API 키 (AI 소개글). 프론트엔드와 GitHub에는 절대 넣지 않는다.
GPT_API_KEY="sk-..."
# 쓸 모델 (선택, 기본 gpt-5.4-mini)
GPT_MODEL="gpt-5.4-mini"

# 요청을 허용할 프론트엔드 주소. 여러 개면 쉼표로 구분. 끝에 / 를 붙이지 않는다.
FRONTEND_ORIGIN="http://localhost:3100"

# 서버 포트 (Render에서는 자동)
PORT=4100
